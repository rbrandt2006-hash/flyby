{
  "version": 1,
  "sdk_version": "0.22.2",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://fwhddvymmjbjwsiwbtol.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "flyby-ai-mcp",
      "version": "0.1.0",
      "title": "Flyby AI"
    },
    "tools": [
      {
        "name": "list_trips",
        "title": "List trips",
        "description": "List the signed-in user's Flyby AI trips, optionally filtered by status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "draft",
                "pending_approval",
                "confirmed",
                "booked",
                "cancelled",
                "completed"
              ],
              "description": "Filter by trip status."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Max rows to return (default 25)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_trip",
        "title": "Get trip",
        "description": "Fetch full details for one of the signed-in user's trips by id, including flight and hotel details.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "trip_id": {
              "type": "string",
              "format": "uuid",
              "description": "Trip id (UUID)."
            }
          },
          "required": [
            "trip_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_expenses",
        "title": "List expenses",
        "description": "List the signed-in user's expenses, optionally filtered by status or trip.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "submitted",
                "approved",
                "rejected"
              ]
            },
            "trip_id": {
              "type": "string",
              "format": "uuid",
              "description": "Only expenses for this trip."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_travel_preferences",
        "title": "Get travel preferences",
        "description": "Get the signed-in user's saved travel preferences (airlines, hotel brands, seat, cost sensitivity, avoid layovers).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
