# Flyby AI — frontend configuration
#
# Leave VITE_API_URL blank for local development: the Vite dev server proxies
# /api, /auth, /rest, /functions and /storage to the Flask backend on :8659,
# so the browser talks to a single origin and there is no CORS to configure.
#
# Set it only for a split deploy, e.g.
#   VITE_API_URL="https://api.flyby.example.com"
VITE_API_URL=""
